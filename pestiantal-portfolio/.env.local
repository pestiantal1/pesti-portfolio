# API Configuration for Portfolio Projects
# These variables are embedded at build time for static export

# Base URL for the project tracker API via Cloudflare Tunnel
NEXT_PUBLIC_API_BASE_URL=https://recognised-took-scenarios-var.trycloudflare.com

# Projects endpoint path
NEXT_PUBLIC_API_ENDPOINT=/public/projects

# Cache TTL in milliseconds (1 hour = 3600000ms)
NEXT_PUBLIC_CACHE_TTL=3600000

# NOTE: Using Cloudflare Tunnel for HTTPS
# Current tunnel: representatives-currency-parking-investigated.trycloudflare.com
# For production, set up a named tunnel with a stable URL


